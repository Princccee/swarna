# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://svarna:svarna@localhost:5432/svarna

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=svarna
S3_REGION=ap-south-1

# Bullion feed
BULLION_FEED_URL=https://your-bullion-api.com/rates
BULLION_FEED_API_KEY=

# GST / IRN
GSTIN=27AAAAA0000A1Z5
GST_STATE_CODE=27  # Maharashtra
IS_INTERSTATE=false
IRP_BASE_URL=https://einvoice1-uat.nic.in
IRP_USERNAME=
IRP_PASSWORD=

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# WhatsApp Cloud API (Meta) — campaigns + keyword auto-replies (RATES, NEW, …)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=svarna-wa-verify
# App secret from Meta App Dashboard → Settings → Basic. Verifies webhook signatures.
WHATSAPP_APP_SECRET=

# Web app network access: 127.0.0.1 = this computer only (default); 0.0.0.0 = also other devices on
# the same Wi-Fi at http://<this-PC's-IP>:5173. Never set 0.0.0.0 on a public server.
WEB_BIND=127.0.0.1

# Rates — the metals.dev API key and Patna premium are set in the app (Settings → Live rates)
# Allow placeholder demo rates to be billed (default: true in development, false in production)
ALLOW_DEMO_RATES=
# Billing refuses rates older than this (hours). 48 covers Sundays, when IBJA publishes no rate.
RATE_MAX_AGE_HOURS=48

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@svarnajewels.com

# Encryption (KYC PII vault)
PII_ENCRYPTION_KEY=32-byte-hex-key-change-in-prod

# Sentry (optional)
SENTRY_DSN=

# Shop
SHOP_NAME=Svarna Jewels
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_LOGO_URL=
