{$SITE_ADDRESS} {
	# Uploaded item/order images live in RustFS. Expose read-only access at /s3/<bucket>/<key>
	# (set S3_PUBLIC_ENDPOINT=https://<site>/s3). Anything other than GET/HEAD is refused.
	@s3read {
		path /s3/*
		method GET HEAD
	}
	handle @s3read {
		uri strip_prefix /s3
		reverse_proxy rustfs:9000 {
			header_up Host rustfs:9000
		}
	}
	handle /s3/* {
		respond 405
	}

	handle {
		reverse_proxy web:80
	}
}
